{
  "manifest_version": 3,
  "name": "Claude для Chrome (Windows 7)",
  "short_name": "Claude",
  "version": "1.0.0",
  "description": "Чат с Claude прямо в браузере. Работает в Chrome 109 на Windows 7.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Claude",
    "default_popup": "chat.html?mode=popup",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Открыть Claude"
    }
  }
}
